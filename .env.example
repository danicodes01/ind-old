# Copy to .env.local and fill in. .env.local is gitignored.
#
# Only EXPO_PUBLIC_-prefixed variables are inlined into the bundle by Expo, and they are
# visible in plain text in the compiled app. Never put a secret here — the Supabase anon key
# is safe because it is designed to be public and is constrained by row-level security.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Public by design; RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
